                        },
                        {
                          "type": "text",
                          "id": "watchepisode_t3q",
                          "name": "Introduction",
                          "content": "Introduction",
                          "x": 48.8,
                          "y": 10,
                          "fill": "$slate-900",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "700",
                          "lineHeight": 1.5
                        },
                        {
                          "type": "text",
                          "id": "watchepisode_t3r",
                          "name": "This is the example from lecture 2, and ",
                          "content": "This is the example from lecture 2, and some version of it appears in almost every paper.",
                          "x": 12,
                          "y": 34.4,
                          "fill": "$slate-600",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "400",
                          "lineHeight": 1.625
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t3s",
                      "name": "0:05",
                      "content": "0:05",
                      "x": 37,
                      "y": 149.1,
                      "fill": "$blue-600",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "lineHeight": 1.333
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t3t",
                      "name": "The question",
                      "content": "The question",
                      "x": 73.8,
                      "y": 145.1,
                      "fill": "$slate-900",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t3u",
                      "name": "One person in a thousand carries a virus",
                      "content": "One person in a thousand carries a virus. The test catches 99% of infected people, and clears 95% of healthy people. You test positive. Most people guess 99%, or maybe 95%.",
                      "x": 37,
                      "y": 169.6,
                      "fill": "$slate-600",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "400",
                      "lineHeight": 1.625,
                      "textGrowth": "fixed-width",
                      "width": 678
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t3v",
                      "name": "0:27",
                      "content": "0:27",
                      "x": 37,
                      "y": 240.4,
                      "fill": "$blue-600",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "lineHeight": 1.333
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t3w",
                      "name": "Count people, not percentages",
                      "content": "Count people, not percentages",
                      "x": 73.8,
                      "y": 236.4,
                      "fill": "$slate-900",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t3x",
                      "name": "Forget percentages for a moment. Picture",
                      "content": "Forget percentages for a moment. Picture 10,000 people. 0.1% of them — just 10 people — have the virus.",
                      "x": 37,
                      "y": 260.8,
                      "fill": "$slate-600",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "400",
                      "lineHeight": 1.625
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t3y",
                      "name": "0:39",
                      "content": "0:39",
                      "x": 37,
                      "y": 310.5,
                      "fill": "$blue-600",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "lineHeight": 1.333
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t3z",
                      "name": "Everyone takes the test",
                      "content": "Everyone takes the test",
                      "x": 73.8,
                      "y": 306.5,
                      "fill": "$slate-900",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t40",
                      "name": "Now test everybody. The 10 infected peop",
                      "content": "Now test everybody. The 10 infected people: 99% of 10 is 9.9, so about 10 positive results. The 9,990 healthy people: 5% of them get a false positive. That is about 500 people. The test is good. The problem is that there are so many more healthy people to make mistakes on.",
                      "x": 37,
                      "y": 330.9,
                      "fill": "$slate-600",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "400",
                      "lineHeight": 1.625,
                      "textGrowth": "fixed-width",
                      "width": 712.9
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t41",
                      "name": "1:02",
                      "content": "1:02",
                      "x": 37,
                      "y": 422.9,
                      "fill": "$blue-600",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "lineHeight": 1.333
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t42",
                      "name": "Only the positives",
                      "content": "Only the positives",
                      "x": 73.8,
                      "y": 418.9,
                      "fill": "$slate-900",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t43",
                      "name": "You tested positive, so you are one of t",
                      "content": "You tested positive, so you are one of these. Gather everyone with a positive result. 510 people: 10 infected, 500 healthy. So your chance is 10 out of 510 — about 2%. The base rate, not the test, dominates.",
                      "x": 37,
                      "y": 443.3,
                      "fill": "$slate-600",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "400",
                      "lineHeight": 1.625,
                      "textGrowth": "fixed-width",
                      "width": 691.5
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t44",
                      "name": "1:21",
                      "content": "1:21",
                      "x": 37,
                      "y": 514.1,
                      "fill": "$blue-600",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "lineHeight": 1.333
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t45",
                      "name": "The same thing as Bayes’ rule",
                      "content": "The same thing as Bayes’ rule",
                      "x": 73.8,
                      "y": 510.1,
                      "fill": "$slate-900",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t46",
                      "name": "Bayes’ rule is exactly this counting, wr",
                      "content": "Bayes’ rule is exactly this counting, written with probabilities. The numerator is the infected positives. The denominator is every positive — the total probability of a positive result. Plug in the lecture’s numbers: 0.00099 over 0.05094, about 0.0194. Write the denominator out in full — that is where exam marks are.",
                      "x": 37,
                      "y": 534.6,
                      "fill": "$slate-600",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "400",
                      "lineHeight": 1.625,
                      "textGrowth": "fixed-width",
                      "width": 714
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t47",
                      "name": "1:50",
                      "content": "1:50",
                      "x": 37,
                      "y": 626.5,
                      "fill": "$blue-600",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "lineHeight": 1.333
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t48",
                      "name": "Test again",
                      "content": "Test again",
                      "x": 73.8,
                      "y": 622.5,
                      "fill": "$slate-900",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t49",
                      "name": "What if you take the test a second time,",
                      "content": "What if you take the test a second time, and it is positive again? Use 2% as the new prior. One more positive takes it to about 28%, a third to about 89%. That is the idea behind repeat testing — and a favourite follow-up question.",
                      "x": 37,
                      "y": 646.9,
                      "fill": "$slate-600",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "400",
                      "lineHeight": 1.625,
                      "textGrowth": "fixed-width",
                      "width": 713.2
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4a",
                      "name": "2:05",
                      "content": "2:05",
                      "x": 37,
                      "y": 717.8,
                      "fill": "$blue-600",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "lineHeight": 1.333
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4b",
                      "name": "Many pieces of evidence",
                      "content": "Many pieces of evidence",
                      "x": 73.8,
                      "y": 713.8,
                      "fill": "$slate-900",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4c",
                      "name": "Real problems have several symptoms. Lec",
                      "content": "Real problems have several symptoms. Lecture 2’s disease Z table has four. Naive Bayes assumes the symptoms are independent given the class, so the likelihood is just a product. Multiply prior and likelihoods for each class, straight from the counts in the table. Z = No wins. Normalise only if the question asks for a probability.",
                      "x": 37,
                      "y": 738.2,
                      "fill": "$slate-600",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "400",
                      "lineHeight": 1.625,
                      "textGrowth": "fixed-width",
                      "width": 718.4
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4d",
                      "name": "2:28",
                      "content": "2:28",
                      "x": 37,
                      "y": 830.1,
                      "fill": "$blue-600",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "lineHeight": 1.333
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4e",
                      "name": "When one count is zero",
                      "content": "When one count is zero",
                      "x": 73.8,
                      "y": 826.1,
                      "fill": "$slate-900",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4f",
                      "name": "Now change one symptom: this patient has",
                      "content": "Now change one symptom: this patient has low blood pressure. In the training data, no patient with Z = No had low blood pressure. So that factor is zero, and it wipes out the whole product — no matter what the other symptoms say.",
                      "x": 37,
                      "y": 850.6,
                      "fill": "$slate-600",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "400",
                      "lineHeight": 1.625,
                      "textGrowth": "fixed-width",
                      "width": 716.8
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4g",
                      "name": "2:52",
                      "content": "2:52",
                      "x": 37,
                      "y": 921.4,
                      "fill": "$blue-600",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "lineHeight": 1.333
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4h",
                      "name": "α-Laplace smoothing",
                      "content": "α-Laplace smoothing",
                      "x": 73.8,
                      "y": 917.4,
                      "fill": "$slate-900",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4i",
                      "name": "Pretend you saw every value α more times",
                      "content": "Pretend you saw every value α more times than you did. Add α on top, and m·α at the bottom, where m is how many values the feature can take: 3 for blood pressure, 2 for diabetes. Nothing is zero any more. Exams love to ask for exactly this table with α = 1.",
                      "x": 37,
                      "y": 941.8,
                      "fill": "$slate-600",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "400",
                      "lineHeight": 1.625,
                      "textGrowth": "fixed-width",
                      "width": 715.3
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4j",
                      "name": "3:12",
                      "content": "3:12",
                      "x": 37,
                      "y": 1033.8,
                      "fill": "$blue-600",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "lineHeight": 1.333
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4k",
                      "name": "Recap",
                      "content": "Recap",
                      "x": 73.8,
                      "y": 1029.8,
                      "fill": "$slate-900",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "watchepisode_t4l",
                      "name": "Three things to take into the exam. Then",
                      "content": "Three things to take into the exam. Then try the base-rate page, and the naive Bayes table with smoothing switched on.",
                      "x": 37,
                      "y": 1054.2,
                      "fill": "$slate-600",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "400",
                      "lineHeight": 1.625,
                      "textGrowth": "fixed-width",
                      "width": 713.3
                    }
                  ]
