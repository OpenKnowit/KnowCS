                      "children": [
                        {
                          "type": "text",
                          "id": "watchepisode_t3p",
                          "name": "0:00",
                          "content": "0:00",
                          "x": 12,
                          "y": 14,
                          "fill": "$blue-600",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "700",
